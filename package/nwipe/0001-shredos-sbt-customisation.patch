diff --git a/src/create_single_disc_pdf.c b/src/create_single_disc_pdf.c
index 4da6961..505e5f5 100644
--- a/src/create_single_disc_pdf.c
+++ b/src/create_single_disc_pdf.c
@@ -519,18 +519,48 @@ int create_single_disc_pdf( nwipe_thread_data_ptr_t* ptrx, nwipe_context_t* ptr
      *
      * Sanitize the strings that we are going to use to create the report filename
      * by converting any non alphanumeric characters to an underscore or hyphen
+     *
+     * SBT: The report filename format is
+     * Nwipe_<DD-MM-YYYY>_<HH-MM-SS>_System-<system serial>_Drive-<drive serial>.pdf
      */
-    replace_non_alphanumeric( end_time_text, '-' );
+    char sbt_filename_time_text[50];
+    char sbt_system_serial_text[DMIDECODE_RESULT_LENGTH];
+
+    /* Filename timestamp as day-month-year_hour-min-sec. */
+    p = localtime( &c->end_time );
+    snprintf( sbt_filename_time_text,
+              sizeof( sbt_filename_time_text ),
+              "%02i-%02i-%04i_%02i-%02i-%02i",
+              p->tm_mday,
+              1 + p->tm_mon,
+              1900 + p->tm_year,
+              p->tm_hour,
+              p->tm_min,
+              p->tm_sec );
+
+    /* Sanitize a copy of the system serial; the shared misc struct field must
+     * stay untouched for the system report PDF that is created after this one. */
+    strncpy( sbt_system_serial_text, d->dmidecode_system_serial_number, sizeof( sbt_system_serial_text ) - 1 );
+    sbt_system_serial_text[sizeof( sbt_system_serial_text ) - 1] = '\0';
+    replace_non_alphanumeric( sbt_system_serial_text, '_' );
+    if( sbt_system_serial_text[0] == '\0' )
+    {
+        snprintf( sbt_system_serial_text, sizeof( sbt_system_serial_text ), "UNKNOWN" );
+    }
+
     replace_non_alphanumeric( c->device_model, '_' );
     replace_non_alphanumeric( c->device_serial_no, '_' );
+    if( c->device_serial_no[0] == '\0' )
+    {
+        snprintf( c->device_serial_no, sizeof( c->device_serial_no ), "UNKNOWN" );
+    }
     snprintf( c->PDF_filename,
               sizeof( c->PDF_filename ),
-              "%s/nwipe_report_%s_Model_%s_Serial_%s_device_%s.pdf",
+              "%s/Nwipe_%s_System-%s_Drive-%s.pdf",
               nwipe_options.PDFreportpath,
-              end_time_text,
-              c->device_model,
-              c->device_serial_no,
-              c->device_name_terse );
+              sbt_filename_time_text,
+              sbt_system_serial_text,
+              c->device_serial_no );
 
     pdf_save( pdf, c->PDF_filename );
     pdf_destroy( pdf );
